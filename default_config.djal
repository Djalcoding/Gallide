!! Border types are [Plain, Thick, Double, Rounded, None] 

!! Main Box
  main box title: default 
  background color: black 
  text color: white 
  border type: Plain
  border color: white

!! Focus
  focus color: white 
  focus text color: black
  focus text: "> " 
  query match color: blue

!! Directories
  folder symbol: "" 
  folder symbol color: white 

!! Files
  file symbol : ""
  file symbol color: white 

!! Search bar
  searchbar title: " Searchbar "
  searchbar background color: black 
  searchbar text color: white 
  searchbar border type: plain
  searchbar border color: white 
  insert searchbar border color: red 
  enable searchbar: yes
  case sensitive: no

!! Tool Tips
  tooltip text color: black 
  tooltip keybind color: white
  tooltip highlight color: white 
  display tooltips: yes

start depth: 1
display directory: yes
ignored directories: /proc, /sys
