!! Main Box
  text color: white 
  border color: white
  background color: black 
  display file size: yes
  default depth: 1
  query match color: red
!! [Plain, Thick, Double, Rounded, None] 
  border type: Plain
!! Focus (Underline entries)
  focus color: white 
  focus text color: black
  focus text: "> " 

!! Directories
  main box title: " Gallide "
  folder symbol: "D " 
  folder symbol color: blue 

!! Files
  file symbol : "F "
  file symbol color: orange 

!! Search bar
  searchbar border color: white 
  searchbar text color: white 
  insert searchbar border color: blue 
  case sensitive: yes
  searchbar title: " Searchbar "
  searchbar background color: black 
!! [Plain, Thick, Double, Rounded, None]
  searchbar border type: Plain

!! Tool Tips
  tooltip text color: black 
  tooltip keybind color: white
  tooltip highlight color: white 

display directory: yes
enable searchbar: yes
display tooltips: yes
thread count: 12
ignored directories: /proc, /sys
directory buffer size: 10000
