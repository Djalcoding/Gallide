!! Main Box
field color: #ffffff
border color: #ffffff
    !! default : white
background color: (25,23,36)
    !! default : black
border type: Double
  !! [Plain, Thick, Double, Rounded, None]
    !! default : Plain

!! Focus (Underline entries)
  focus color: #ffffff
    !! default : white
  focus text: "> " 
    !! default : "> "

!! Directories
main title: "Directories"
    !! default : "Directories"
directory symbol: " " 
    !! default : ""
directory symbol color: #00ff99
    !! default : black

!! Files
file symbol : "󰈔 "
    !! default : white
file symbol color: #00f0ff
    !! default : black

!! Search bar
search bar color: #ffffff
insert mode search bar color: #ff0066
case sensitive: no
search bar title: "Hewwo"

!! [Plain, Thick, Double, Rounded, None]
search bar border type: Rounded

!! Tool Tips
display tooltips: yes
tooltip background color: #ffffff
tooltip keybind color: #ffffff

display directory: yes
enable searchbar: yes
