#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="/lib/gallide/gallide.bin"
if [ "$1" = "--init" ]; then 
    echo "alias g='. $SCRIPT_DIR/gallide';"
elif [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    echo "--Help Menu--"
    echo "-h | --help  displays this menu" 
    echo "--init       aliases g to gallide, this should be put in your .bashrc"
elif [ "$1" ]; then
    cd "$1"
else
    LOGFILE="$(mktemp /tmp/gallide.XXXXXX)"
    script -qec "$BIN" "$LOGFILE"
    OUTPUT=$(tail -n 3 "$LOGFILE" | head -n 1)
    rm "$LOGFILE"
    ITEMPATH=$(echo $OUTPUT | grep -oP "(\/[^()]*)+")
    if [[ "$OUTPUT" =~ ^\(D\'(\/.*)+\)$ ]]; then
        cd "$ITEMPATH"
    elif [[ "$OUTPUT" =~ ^\(F\'(\/.*)+\)$ ]]; then
        if [ -n "$EDITOR" ]; then
            "$EDITOR" "$ITEMPATH"
        elif [ -n "$VISUAL" ]; then
            "$VISUAL" "$ITEMPATH"
        else
            cat "$ITEMPATH"
        fi
    else
        echo "Unknown item path : $OUTPUT" >&2
    fi
fi
